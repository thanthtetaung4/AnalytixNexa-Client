# Copy to .env.local for local overrides. None of these are required for
# development: `npm run dev` proxies /api and /health to the API already.

# Where the API lives, including the version prefix. Leave unset in development
# (the dev server proxies /api/v1); set it for a production build.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Dev-server only: where /api and /health are proxied to.
# VITE_API_PROXY_TARGET=http://localhost:8000

# The seeded demo account behind "Explore the demo workspace" on the sign-in
# page (see `make seed` in the API repo). Public sample-data credentials.
# VITE_DEMO_EMAIL=demo@analytixnexa.io
# VITE_DEMO_PASSWORD=demo1234

# --- telemetry -------------------------------------------------------------
# Browser telemetry: uncaught errors, API calls (method, route, status,
# duration) and route changes, sent to the OpenTelemetry collector. Never
# request or response bodies, form values, or query strings — and paths are
# reduced to templates (/datasets/:id) before they leave the page.
# VITE_TELEMETRY_ENABLED=true
# VITE_SERVICE_NAME=analytixnexa-client
# VITE_DEPLOY_ENV=development

# Where the batches are posted. The default goes through the dev server's
# /otlp proxy, so there is no CORS preflight; set an absolute URL for a
# production build.
# VITE_OTLP_ENDPOINT=/otlp

# Dev-server only: where /otlp is proxied to.
# VITE_OTLP_PROXY_TARGET=http://localhost:4318
